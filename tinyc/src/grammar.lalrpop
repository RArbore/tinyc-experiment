use core::str::FromStr;

use crate::ast::*;

grammar(counter: &mut Label);

pub Program: Vec<FuncAST> = {
    Func* => <>,
}

Func: FuncAST = {
    "fn" <name:Iden> "(" <params:List<Iden>> ")" <body:Stmt> => FuncAST { name, params, body },
}

Stmt: StmtAST = {
    Block => <>,
    <var:Iden> "=" <expr:BinaryExpr> ";" => StmtAST::Assign { var, expr, label: inc_label(counter) },
    "*" <pointer:BinaryExpr> "=" <expr:BinaryExpr> ";" => StmtAST::Store { pointer, expr, label: inc_label(counter) },
    "if" <cond:BinaryExpr> <then_body:Block> <else_body:("else" <Block>)?> => StmtAST::IfElse { cond, then_body: Box::new(then_body), else_body: Box::new(else_body.unwrap_or_else(|| StmtAST::Block { body: vec![] })), merge: inc_label(counter) },
    "while" <cond:BinaryExpr> <body:Block> => StmtAST::While { cond, body: Box::new(body), header: inc_label(counter), exit: inc_label(counter) },
    "return" <expr:BinaryExpr> ";" => StmtAST::Return { expr, label: inc_label(counter) },
}

Block: StmtAST = "{" <body:Stmt*> "}" => StmtAST::Block { body };

BinaryExpr: ExprAST = {
    #[precedence(level="0")]
    UnaryExpr,
    #[precedence(level="1")] #[assoc(side="left")]
    <lhs:BinaryExpr> "*" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::Mul, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    #[precedence(level="2")] #[assoc(side="left")]
    <lhs:BinaryExpr> "+" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::Add, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    <lhs:BinaryExpr> "-" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::Sub, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    #[precedence(level="3")] #[assoc(side="left")]
    <lhs:BinaryExpr> "==" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::EE, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    <lhs:BinaryExpr> "!=" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::NE, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    <lhs:BinaryExpr> "<" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::LT, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    <lhs:BinaryExpr> "<=" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::LE, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    <lhs:BinaryExpr> ">" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::GT, lhs: Box::new(lhs), rhs: Box::new(rhs) },
    <lhs:BinaryExpr> ">=" <rhs:BinaryExpr> => ExprAST::Binary { op: BinaryOp::GE, lhs: Box::new(lhs), rhs: Box::new(rhs) },
}

UnaryExpr: ExprAST = {
    Atomic,
    "!" <UnaryExpr> => ExprAST::Unary { op: UnaryOp::Not, input: Box::new(<>) },
    "-" <UnaryExpr> => ExprAST::Unary { op: UnaryOp::Neg, input: Box::new(<>) },
    "*" <UnaryExpr> => ExprAST::Load { pointer: Box::new(<>) },
}

Atomic: ExprAST = {
    Num => ExprAST::Number(<>),
    Iden => ExprAST::Variable(<>),
    "(" <BinaryExpr> ")",
}

Iden: String = r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string();
Num: i64 = r"-?[0-9]+" => i64::from_str(<>).unwrap();

List<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            v.push(e);
            v
        }
    }
};
